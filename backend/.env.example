# ==============================================================================
# AQ COMPANIES — Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL USE ONLY. NEVER COMMIT REAL CREDENTIALS.
# ==============================================================================

# Application Environment: development | testing | staging | production
APP_ENV=development
DEBUG=true

# Service Versioning
VERSION=2.0.0
BUILD_COMMIT=local-dev
BUILD_DATE=2026-09-27

# Database Connection (Use PostgreSQL in Production / Staging)
# Development (SQLite local):
DATABASE_URL=sqlite:///aq_companies.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://aq_user:CHANGE_ME_PASSWORD@localhost:5432/aq_companies_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Security & Authentication (MUST BE CHANGED IN PRODUCTION)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_HEX_SECRET_IN_PRODUCTION_ENV_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deployment & Maintenance Lock
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=CHANGE_ME_MAINTENANCE_BYPASS_SECRET_TOKEN

# Distributed Cache & Queues (Optional in local dev, recommended in production)
# REDIS_URL=redis://localhost:6379/0

# Optional Error Monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Storage Paths (Isolated automatically by environment)
BACKUP_PATH=./backups
UPLOAD_PATH=./uploads
LOG_PATH=./logs

# Operational Monitoring Thresholds
LOG_LEVEL=INFO
DISK_WARNING_THRESHOLD_PCT=20
DISK_CRITICAL_THRESHOLD_PCT=10

# Production CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Feature Flags
FEATURE_NEW_RECONCILIATION_ENGINE=false
FEATURE_ADVANCED_FX=false
FEATURE_CURSOR_PAGINATION=true
