# ==============================================================================
# AQ COMPANIES — Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL USE ONLY. NEVER COMMIT REAL CREDENTIALS.
# ==============================================================================

APP_ENV=development
DEBUG=true

# Database (PostgreSQL recommended for production)
DATABASE_URL=sqlite:///backend/aq_companies.db

# Security & Authentication (MUST BE CHANGED IN PRODUCTION)
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_HEX_SECRET_IN_PRODUCTION_ENV_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deployment & Maintenance Lock
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=CHANGE_ME_MAINTENANCE_BYPASS_SECRET_TOKEN

# Distributed Cache
# REDIS_URL=redis://localhost:6379/0

# Storage Paths
BACKUP_PATH=./backend/backups
UPLOAD_PATH=./backend/uploads
LOG_PATH=./backend/logs

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
